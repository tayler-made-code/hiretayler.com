---
interface Props {
  /** the home page uses bare hashes; other pages need to come back to "/" first */
  home?: boolean;
}
const { home = false } = Astro.props;
const base = home ? '' : '/';
---
<header class="topbar">
  <div class="wrap">
    <a class="brand" href={home ? '#top' : '/'}>Tayler Coon<em>.</em></a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <nav id="site-nav" aria-label="Sections">
      <a href={`${base}#about`}>About</a>
      <a href={`${base}#do`}>What I do</a>
      <a href={`${base}#work`}>Work</a>
      <a href={`${base}#talk`}>Let's talk</a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu. The nav is plain anchors, so this only opens and closes it.
  const btn = document.querySelector('.menu-btn');
  const nav = document.getElementById('site-nav');

  if (btn && nav) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    };

    btn.addEventListener('click', () => {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    // jumping to a section should close it
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        (btn as HTMLElement).focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (btn.getAttribute('aria-expanded') !== 'true') return;
      const t = e.target as Node;
      if (!nav.contains(t) && !btn.contains(t)) setOpen(false);
    });

    // if it's open and the viewport grows past the breakpoint, drop the state
    window.matchMedia('(min-width: 761px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
