---
interface SpecLine {
  k: string;
  v: string;
}
interface PreviewImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}
interface Props {
  title: string;
  one: string;
  status: string;
  meta?: string;
  /** omit when the project has nowhere public to go: the card renders as an
      article instead of a link, so it never lands in the tab order */
  href?: string;
  image?: string | null;
  alt?: string;
  /** temporary destination for work that is not live yet: opens an accessible
      full-size image dialog instead of pretending the project has a URL */
  previewImage?: string;
  previewAlt?: string;
  previewWidth?: number;
  previewHeight?: number;
  previewImages?: PreviewImage[];
  width?: number;
  height?: number;
  /** wide app screenshots read better cropped from the top-left */
  cropTopLeft?: boolean;
  /** preserve the complete screenshot inside the standard card frame */
  containImage?: boolean;
  eager?: boolean;
  spec?: SpecLine[];
}
const {
  title,
  one,
  status,
  meta = '',
  href,
  image = null,
  alt = '',
  previewImage,
  previewAlt,
  previewWidth = 1920,
  previewHeight = 1080,
  previewImages = [],
  width = 800,
  height = 600,
  cropTopLeft = false,
  containImage = false,
  eager = false,
  spec = [],
} = Astro.props;

const hasGallery = previewImages.length > 0;
const isPreview = Boolean((previewImage || hasGallery) && !href);
const Tag = href ? 'a' : 'article';
const external = href?.startsWith('http');
---
<Tag
  class:list={['card', !href && 'card--static']}
  href={href}
  rel={external ? 'noopener' : undefined}
>
  <div class="media">
    {image ? (
      <img
        class:list={['shot', cropTopLeft && 'shot--topleft', containImage && 'shot--contain']}
        src={image}
        alt={alt}
        width={width}
        height={height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="spec">
        {spec.map((line) => (
          <div><b>{line.k}</b> {line.v}</div>
        ))}
      </div>
    )}
  </div>

  <h3>{title}</h3>
  <p class="one card-dim">{one}</p>

  <div class="foot">
    <span class="dot">{status}</span>
    {meta && <span class="card-dim">{meta}</span>}
  </div>

  {isPreview && (
    <button
      type="button"
      class="card-hit"
      data-preview-image={!hasGallery ? previewImage : undefined}
      data-preview-alt={previewAlt || alt}
      data-preview-width={!hasGallery ? previewWidth : undefined}
      data-preview-height={!hasGallery ? previewHeight : undefined}
      data-preview-images={hasGallery ? JSON.stringify(previewImages) : undefined}
      data-preview-title={title}
      aria-haspopup="dialog"
    >
      <span class="sr-only">View {title} {hasGallery ? 'image gallery' : 'image at full size'}</span>
    </button>
  )}
</Tag>
