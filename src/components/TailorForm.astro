---
// Client-rendered form that POSTs to the tailor API. The JS lives in an
// island at the bottom of the file; markup here is the progressive-
// enhancement fallback (the contact email still works without JS).
// PUBLIC_TAILOR_ENABLED gates the real form. Dev defaults to "true";
// production builds set it to "false" until the backend email flow is wired.
const apiBase = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
const tailorEnabled = (import.meta.env.PUBLIC_TAILOR_ENABLED ?? 'true') !== 'false';
---
<section
  id="tailor"
  class="mt-10 rounded-[28px] border-2 border-[var(--color-paper)]/15 bg-[var(--color-paper)]/5 p-6 sm:p-8 backdrop-blur-sm"
>
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h3 class="text-2xl sm:text-3xl tracking-tight">
      Tailor my résumé to your role.
    </h3>
    <span class="text-xs uppercase tracking-[0.22em] text-[var(--color-red)] font-bold">
      AI · on-demand
    </span>
  </div>

  <p class="mt-2 text-sm sm:text-base text-[var(--color-paper)]/75 max-w-2xl">
    Tell me about the role. I'll draft a résumé for it, and we'll have something to talk about.
  </p>

  <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-[var(--color-paper)]/70">
    <span>Prefer a terminal?</span>
    <button
      type="button"
      data-copy-ssh
      aria-label="Copy ssh command"
      class="group inline-flex items-center gap-2 rounded-full border border-[var(--color-paper)]/20 bg-[var(--color-paper)]/5 hover:bg-[var(--color-paper)]/15 transition-colors px-3 py-1.5"
    >
      <code class="font-mono text-[var(--color-red)] text-xs sm:text-sm">ssh hire@hiretayler.com</code>
      <svg data-copy-icon width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-paper)]/60 group-hover:text-[var(--color-paper)]" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <svg data-check-icon width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="hidden text-[var(--color-red)]" aria-hidden="true">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </button>
    <span data-copy-feedback class="hidden text-xs text-[var(--color-red)] font-semibold">copied</span>
  </div>

  {!tailorEnabled && (
    <div class="mt-6 rounded-2xl border border-[var(--color-paper)]/15 bg-[var(--color-paper)]/5 px-5 py-4 text-sm sm:text-base text-[var(--color-paper)]/80">
      The tailor's out at lunch. In the meantime, just email me at <a href="mailto:tayler.coon@gmail.com" class="underline decoration-2 underline-offset-4 text-[var(--color-red)] font-semibold hover:no-underline">tayler.coon@gmail.com</a> and mention the role.
    </div>
  )}

  <form id="tailor-form" class={`mt-6 grid gap-4 ${tailorEnabled ? '' : 'hidden'}`} data-api-base={apiBase}>
    <div class="grid sm:grid-cols-2 gap-4">
      <label class="flex flex-col gap-1.5">
        <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-paper)]/70 font-bold">Your name</span>
        <input
          name="hirer_name"
          type="text"
          required
          maxlength="120"
          placeholder="Bruce Wayne"
          class="rounded-full bg-[var(--color-paper)] text-[var(--color-ink)] px-4 py-2.5 text-base font-medium placeholder:text-[var(--color-dim)]/70 focus:outline-none focus:ring-2 focus:ring-[var(--color-red)]"
        />
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-paper)]/70 font-bold">Your email</span>
        <input
          name="hirer_email"
          type="email"
          required
          maxlength="200"
          placeholder="bruce@wayneenterprises.com"
          class="rounded-full bg-[var(--color-paper)] text-[var(--color-ink)] px-4 py-2.5 text-base font-medium placeholder:text-[var(--color-dim)]/70 focus:outline-none focus:ring-2 focus:ring-[var(--color-red)]"
        />
      </label>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <label class="flex flex-col gap-1.5">
        <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-paper)]/70 font-bold">Job title</span>
        <input
          name="job_title"
          type="text"
          required
          maxlength="120"
          placeholder="full-stack software engineer"
          class="rounded-full bg-[var(--color-paper)] text-[var(--color-ink)] px-4 py-2.5 text-base font-medium placeholder:text-[var(--color-dim)]/70 focus:outline-none focus:ring-2 focus:ring-[var(--color-red)]"
        />
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-paper)]/70 font-bold">Hiring company</span>
        <input
          name="hiring_company"
          type="text"
          required
          maxlength="120"
          placeholder="Wayne Enterprises"
          class="rounded-full bg-[var(--color-paper)] text-[var(--color-ink)] px-4 py-2.5 text-base font-medium placeholder:text-[var(--color-dim)]/70 focus:outline-none focus:ring-2 focus:ring-[var(--color-red)]"
        />
      </label>
    </div>

    <label class="flex flex-col gap-1.5">
      <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-paper)]/70 font-bold">Job description</span>
      <textarea
        name="job_description"
        required
        minlength="30"
        maxlength="4000"
        rows="6"
        placeholder="paste it here, or just tell me about the role"
        class="rounded-2xl bg-[var(--color-paper)] text-[var(--color-ink)] px-4 py-3 text-base leading-relaxed placeholder:text-[var(--color-dim)]/70 focus:outline-none focus:ring-2 focus:ring-[var(--color-red)]"
      ></textarea>
    </label>

    <div class="flex flex-wrap items-center gap-4">
      <button
        type="submit"
        class="inline-flex items-center gap-2 rounded-full bg-[var(--color-red)] text-[var(--color-paper)] px-6 py-3 text-base font-semibold hover:-translate-y-0.5 transition-transform duration-150 disabled:opacity-50 disabled:cursor-wait"
      >
        <span data-idle>Tailor it</span>
        <span data-busy class="hidden">Tailoring...</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="M13 6l6 6-6 6"></path>
        </svg>
      </button>
      <span id="tailor-char" class="text-xs text-[var(--color-paper)]/55 font-mono">0 / 4000</span>
    </div>

    <p id="tailor-error" class="hidden mt-1 text-sm text-[var(--color-red)] font-semibold"></p>
  </form>

  <article
    id="tailor-result"
    class="hidden mt-8 rounded-[22px] bg-[var(--color-paper)] text-[var(--color-ink)] p-6 sm:p-8"
    aria-live="polite"
  ></article>
</section>

<script>
  // Copy-to-clipboard for the SSH command, with icon swap + feedback.
  const sshBtn = document.querySelector<HTMLButtonElement>('[data-copy-ssh]');
  if (sshBtn) {
    const copyIcon = sshBtn.querySelector<SVGElement>('[data-copy-icon]');
    const checkIcon = sshBtn.querySelector<SVGElement>('[data-check-icon]');
    const feedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
    let reverting: ReturnType<typeof setTimeout> | null = null;
    sshBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('ssh hire@hiretayler.com');
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        feedback?.classList.remove('hidden');
        if (reverting) clearTimeout(reverting);
        reverting = setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
          feedback?.classList.add('hidden');
          reverting = null;
        }, 1600);
      } catch (err) {
        console.error('clipboard:', err);
      }
    });
  }

  const form = document.getElementById('tailor-form') as HTMLFormElement | null;
  if (form) {
    const apiBase = form.dataset.apiBase ?? '';
    const desc = form.querySelector<HTMLTextAreaElement>('[name=job_description]');
    const counter = document.getElementById('tailor-char');
    const errEl = document.getElementById('tailor-error');
    const result = document.getElementById('tailor-result');
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]');
    const idleLabel = submit?.querySelector<HTMLElement>('[data-idle]');
    const busyLabel = submit?.querySelector<HTMLElement>('[data-busy]');

    const showErr = (msg: string) => {
      if (!errEl) return;
      errEl.textContent = msg;
      errEl.classList.remove('hidden');
    };
    const clearErr = () => errEl?.classList.add('hidden');

    if (desc && counter) {
      const tick = () => {
        counter.textContent = `${desc.value.length} / 4000`;
      };
      desc.addEventListener('input', tick);
      tick();
    }

    const escapeHTML = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      }[c] as string));

    const render = (data: any) => {
      if (!result) return;
      if (data?.refused) {
        result.innerHTML = `<p class="text-[var(--color-red)] font-semibold">${escapeHTML(data.message ?? 'refused.')}</p>`;
        result.classList.remove('hidden');
        return;
      }
      const sections = (data?.sections ?? [])
        .map((s: any) => `
          <section class="mt-6 first:mt-0">
            <h4 class="text-xs uppercase tracking-[0.22em] text-[var(--color-teal)] font-bold">${escapeHTML(s.header)}</h4>
            <div class="mt-2 text-base leading-relaxed whitespace-pre-wrap">${escapeHTML(s.body)}</div>
          </section>`)
        .join('');
      const footer = data?.footer
        ? `<p class="mt-8 text-xs text-[var(--color-dim)]">${escapeHTML(data.footer)}</p>`
        : '';
      const note = data?.relevance_note
        ? `<p class="mt-2 text-xs italic text-[var(--color-dim)]">(${escapeHTML(data.relevance_note)})</p>`
        : '';
      result.innerHTML = sections + footer + note;
      result.classList.remove('hidden');
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErr();
      result?.classList.add('hidden');

      const data = Object.fromEntries(new FormData(form).entries());

      if (!submit) return;
      submit.disabled = true;
      idleLabel?.classList.add('hidden');
      busyLabel?.classList.remove('hidden');

      try {
        const res = await fetch(`${apiBase}/api/tailor`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) {
          const body = await res.text();
          showErr(`something broke (${res.status}). try again in a minute.`);
          console.error('tailor error', res.status, body);
        } else {
          const json = await res.json();
          render(json);
        }
      } catch (err) {
        showErr('network error. is the server up?');
        console.error(err);
      } finally {
        submit.disabled = false;
        idleLabel?.classList.remove('hidden');
        busyLabel?.classList.add('hidden');
      }
    });
  }
</script>
