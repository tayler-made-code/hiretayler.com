---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import InquiryModal from '../components/InquiryModal.astro';
import ImagePreview from '../components/ImagePreview.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const projects = [
  {
    title: 'Itty Bitty Budget Committee',
    one: "The operating system for my household. Money, meals, and the 13-week calendar it all hangs off.",
    status: 'Active',
    meta: 'private · view screen',
    image: '/images/ibbc-card.webp',
    alt: 'IBBC Meal Rhythm screen showing a four-week cyclic meal plan',
    previewImage: '/images/ibbc-full.webp',
    previewAlt: 'IBBC Meal Rhythm app showing a four-week meal plan, daily meals, grocery outlook, and household navigation',
  },
  {
    title: 'Common Cents',
    one: 'Round-up donations that send spare change to local causes. Concept and front-end lead, four-week MVP.',
    status: 'Live',
    meta: '2024',
    href: 'https://commoncents.hiretayler.com/',
    image: '/images/common-cents-card.webp',
    alt: 'Common Cents dashboard showing impact totals, weekly allocations, recent roundups, and supported causes',
    width: 800,
    height: 450,
    containImage: true,
  },
  {
    title: 'Fellowship of Oklahoma Ale Makers',
    one: 'I run the web presence for a real club with real members, which is a different job than shipping a demo.',
    status: 'Ongoing',
    meta: 'alemakers.org',
    href: 'https://alemakers.org',
    image: '/images/foam-card.webp',
    alt: 'alemakers.org homepage: Better beer with good people',
  },
  {
    title: 'Cardinal',
    one: "Territory management with route planning built in, so the map and the day's route stop being two tools.",
    status: 'Building',
    meta: 'view 6 screens',
    image: '/images/cardinal-card.webp',
    alt: 'Cardinal week route and drive-time territory screens',
    previewImages: [
      { src: '/images/cardinal-today.webp', alt: 'Cardinal Today screen with schedule and territory tasks', width: 542, height: 1044 },
      { src: '/images/cardinal-route.webp', alt: 'Cardinal week route with scheduled property visits', width: 542, height: 1044 },
      { src: '/images/cardinal-insights.webp', alt: 'Cardinal territory insights with coverage and drive-time distribution', width: 542, height: 1044 },
      { src: '/images/cardinal-map.webp', alt: 'Cardinal locations map with demo property markers around Tulsa', width: 542, height: 1044 },
      { src: '/images/cardinal-drive-times.webp', alt: 'Cardinal locations map with drive-time territory boundaries', width: 542, height: 1044 },
      { src: '/images/cardinal-locations.webp', alt: 'Cardinal locations list with drive-time and territory labels', width: 542, height: 1044 },
    ],
  },
  {
    title: 'Draft Cast',
    one: 'A taproom menu board tuned for a ten-foot read. Backend runs; the front end is mid-rebuild for distance.',
    status: 'Building',
    meta: 'view full menu',
    image: '/images/draft-cast-card.webp',
    alt: 'Draft Cast taproom menu showing six beers with styles, ABV, IBU, and descriptions',
    previewImage: '/images/draft-cast-full.webp',
  },
];
---
<Base>
  <a class="skip-link" href="#work">Skip to the work</a>

  <SiteNav home />

  <main id="top">
    <div class="wrap">

      <!-- HERO -->
      <header class="hero">
        <p class="status">Open to full-stack roles · Tulsa, OK</p>
        <div class="portrait">
          <img src="/images/tayler.webp" alt="Tayler Coon" width="600" height="600" fetchpriority="high" decoding="async" />
        </div>
        <h1>
          <span class="greeting">Hey there, I'm Tayler</span>
          <em>I build stuff.</em>
        </h1>
        <div class="cta">
          <a class="btn" href="#work">See the work</a>
          <button class="btn btn--ghost" type="button" data-open-inquiry>Start a conversation</button>
        </div>
      </header>

      <!-- ABOUT -->
      <section class="band" id="about" aria-labelledby="about-h">
        <h2 class="eyebrow" id="about-h">About</h2>
        <div class="about">
          <div>
            <p>
              I came to engineering through tech support. Ten years at the Help Desk
              taught me how to listen past the noise, find the real problem, and
              untangle a mess before reaching for a tool.
            </p>
            <p>
              Atlas School gave me a new toolset: twenty months of full-stack work,
              paired programming, and shipping something every week.
            </p>
            <p>
              Now I freelance and build whatever keeps me curious. Give me a real
              problem, good people, and something worth shipping.
            </p>
          </div>
          <aside class="after">
            <p class="after-label">What I'm after</p>
            <blockquote>Work I'd tell my friends about, with people I'd meet for a beer<em>.</em></blockquote>
            <ul class="stack">
              <li>React</li><li>Next.js</li><li>TypeScript</li><li>Python</li>
              <li>Node</li><li>PostgreSQL</li><li>Supabase</li><li>Figma</li>
            </ul>
          </aside>
        </div>
      </section>

      <!-- WHAT I DO -->
      <section class="band" id="do" aria-labelledby="do-h">
        <h2 class="eyebrow" id="do-h">What I do</h2>
        <div class="do-row">
          <span class="do-num">01</span>
          <h3>Product engineering</h3>
          <p>Front to back on web apps people actually open. React, Next.js and TypeScript on the screen, Node, Python, Postgres and Supabase behind it, and whatever else the project actually requires.</p>
        </div>
        <div class="do-row">
          <span class="do-num">02</span>
          <h3>Finding the problem</h3>
          <p>Good solutions start with the right problem. I ask questions until the noise falls away and the thing that actually needs fixing is clear. Once I understand the problem, the path forward usually gets a lot shorter.</p>
        </div>
        <div class="do-row">
          <span class="do-num">03</span>
          <h3>Building the solution</h3>
          <p>Workarounds are useful until they become the work. I build the system that removes the recurring problem, then make it simple enough to run without me. If I'm still needed to keep it moving, it isn't finished.</p>
        </div>
      </section>

      <!-- SELECTED WORK -->
      <section class="band" id="work" aria-labelledby="work-h">
        <p class="eyebrow">Selected work</p>
        <div class="band-head">
          <h2 id="work-h">Built to be used<em>.</em></h2>
          <a class="more" href="https://github.com/tayler-made-code">All projects</a>
        </div>

        <div class="work">
          {projects.map((p) => <ProjectCard {...p} />)}
        </div>
      </section>

      <!-- CURRENTLY -->
      <section class="band currently" id="now" aria-labelledby="now-h">
        <h2 class="eyebrow" id="now-h">Currently</h2>
        <div class="row2">
          <div>
            <h3>Available for the right team<em>.</em></h3>
            <p>
              Freelancing now. Looking for a full-stack role with good people
              building something worth shipping.
            </p>
          </div>
          <a class="more" href="#talk">Get in touch &#8599;</a>
        </div>
      </section>

      <!-- LET'S TALK -->
      <section class="inquiry" id="talk" aria-labelledby="talk-h">
        <p class="eyebrow">Let's talk</p>
        <h2 id="talk-h">Looking for someone who <em>actually builds</em>?</h2>
        <p class="punch">
          <span>I'm checking my email</span>
          <span>Probably right now</span>
        </p>


        <div class="actions">
          <button class="btn" type="button" data-open-inquiry>Start here</button>
          <span class="alt">
            or email <a href="mailto:tayler.coon@gmail.com">tayler.coon@gmail.com</a>
          </span>
        </div>
      </section>
    </div>

    <SiteFooter />
  </main>

  <InquiryModal />
  <ImagePreview />

</Base>
